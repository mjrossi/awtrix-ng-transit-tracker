# Machine-specific settings and secrets. Copy to mise.local.toml, which is
# gitignored, and fill in what you use. mise loads it automatically inside
# this repo, so `just run`, `just preview` and tests see these variables.
#
# config.toml reads secrets as ${NAME}, for example:
#   [providers.metrolisboa]
#   client_id = "${METRO_LISBOA_CLIENT_ID}"

[env]
# Metro de Lisboa API: consumer key and secret of an application subscribed
# to EstadoServicoML at https://api.metrolisboa.pt/store/. These names are
# the ones `urbanist-timetable systems show metro-lisboa` prints and
# `just catalog-check` reads.
# METRO_LISBOA_CLIENT_ID = ""
# METRO_LISBOA_CLIENT_SECRET = ""

# TfL app key from https://api-portal.tfl.gov.uk/. Optional: without it the
# `tfl` system works at a lower rate limit.
# TFL_APP_KEY = ""

# Transitland API key from https://www.transit.land/, as named in
# config.example.toml.
# TRANSITLAND_API_KEY = ""

# AWTRIX NG clock credentials, if authEnabled is on.
# AWTRIX_PASSWORD = ""
